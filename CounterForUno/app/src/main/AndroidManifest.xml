<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-sdk android:minSdkVersion="30"
        android:targetSdkVersion="34"/>


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CounterForUno"
        tools:targetApi="31">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainMenu"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CounterForUno">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".GameMenu"
            android:screenOrientation="portrait"
            android:label="GameMenu">
        </activity>
        <activity android:name=".PlayerMenu"
          android:screenOrientation="portrait"  >
        </activity>
        <activity android:name=".TotalScore"
            android:theme="@style/Theme.CounterForUno"
            android:screenOrientation="portrait"
            android:label="TotalScore">
        </activity>
        <activity android:name=".Direction"
            android:theme="@style/Theme.CounterForUno"
            android:label="Direction"
            android:screenOrientation="portrait">
        </activity>
    </application>

</manifest>